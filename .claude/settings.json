{
  "enabledPlugins": { "studio@ai-workflow": true, "frontend-design@claude-plugins-official": true },
  "permissions": {
    "allow": [
      "Read(~/git-repository/ai-workflow/plugins/studio/**)",
      "Read(~/git-repository/ideas/**)",
      "Read(~/.claude/studio/**)",
      "WebSearch", "WebFetch", "Bash(studio-browse:*)",
      "mcp__claude_ai_Mobbin__search_screens", "mcp__claude_ai_Mobbin__search_flows", "mcp__claude_ai_Mobbin__search_sections",
      "Bash(npm test)", "Bash(npm test *)", "Bash(npm run *)", "Bash(npm ci)", "Bash(npm ls *)", "Bash(npm view *)",
      "Bash(npx vite *)", "Bash(npx vitest *)", "Bash(npx playwright test *)", "Bash(npx tsc *)",
      "Bash(node scripts/*)", "Bash(python3 scripts/data/*)", "Bash(gitleaks *)",
      "Bash(git status *)", "Bash(git status)", "Bash(git log *)", "Bash(git diff *)", "Bash(git show *)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(ls *)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(grep *)", "Bash(wc *)", "Bash(du *)", "Bash(gzip -c *)",
      "Bash(curl -s *)", "Bash(curl -sS *)", "Bash(curl -sSL *)", "Bash(curl -I *)",
      "Bash(pkill -f vite *)",
      "Bash(npm install *)", "Bash(npm install)", "Bash(npx playwright install *)", "Bash(git worktree *)", "mcp__plugin_figma_figma__get_*"
    ],
    "ask": [ "Bash(git push *)", "Bash(gh repo create *)", "Bash(npm publish *)", "Bash(npx wrangler *)", "Bash(vercel *)", "Bash(netlify *)" ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.config/gh/**)",
      "Bash(curl * -d *)", "Bash(curl * --data*)", "Bash(curl * -F *)", "Bash(wget --post*)",
      "Bash(gh repo edit * --visibility *)", "Bash(gh secret *)"
    ]
  }
}
